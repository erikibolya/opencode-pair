# Password of your OpenCode server. The page sends it as HTTP Basic auth
# with the user name "opencode".
OPENCODE_PASSWORD=change-me

# Credentials that protect the page itself, in the form user:bcrypt-hash.
# Generate them with:
#   htpasswd -nbB oc 'page-password'
# and remember that every "$" has to be doubled when the value is used in a
# compose label (that is why PAIR_AUTH is escaped below).
# PAIR_AUTH=oc:$$2y$$05$$replace-this-with-the-real-hash
